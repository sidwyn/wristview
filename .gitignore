# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Run outputs. Every run directory holds thousands of extracted frames and a
# trained splat. Reproduce them with `wristview run`, do not commit them.
runs/

# Generated test fixture. Rebuild with `python -m tools.make_fixture`.
fixtures/

# Model weights, downloaded on first use.
models/
pretrained_models/

# Source footage. Large binaries do not belong in git without LFS.
#
# Ignore the whole directory rather than a list of extensions. Two earlier
# versions of this rule failed: `wristview-videos/*.mov` stopped matching once
# sessions were filed into dated subfolders and 800 MB went into a commit, and
# an extension list would still miss .m4v, .avi, .mkv, and the .LRV and .THM
# sidecars a phone writes beside each clip. Anything dropped in here is
# footage unless it is a note.
wristview-videos/**
!wristview-videos/**/
!wristview-videos/**/*.md

# Belt and braces: video anywhere in the tree, not just that folder.
*.mov
*.MOV
*.mp4
*.MP4
*.m4v
*.avi
*.mkv
*.webm
*.insv
*.lrv
*.LRV
*.thm
*.THM

.DS_Store

# Rendered deliverables. Videos are large; regenerate with tools/render_wrist_videos.py
deliverables/**/*.mp4
deliverables/**/*.png
exports/

# Trained splats and other large binary artifacts. A 361 MB tensor file is not
# source. Committing one is how this repo once grew to 1.1 GB.
artifacts/
*.pt
*.ply
night-logs/

.venv-lerobot/
